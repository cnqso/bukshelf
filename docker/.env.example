# Bukshelf: the default, self-contained stack (docker/compose.yaml). One Bun
# process, SQLite, and a filesystem data directory — no database or
# object-storage container required. See BUKSHELF_0.1.md for the full picture.

BUKSHELF_IMAGE=bukshelf:local
BUKSHELF_HOST_PORT=43175
# change to a strong secret, min 32 chars
BUKSHELF_SESSION_SECRET=your-super-secret-bukshelf-session-secret-min-32-chars
BUKSHELF_AUTH_ENABLED=true
# set true once you are behind an HTTPS reverse proxy
BUKSHELF_SECURE_COOKIES=false

# Browser-facing origin. Behind an HTTPS reverse proxy, point all three at
# your single public domain (see README's "Serving from a custom domain").
# NOTE: the migration-only section below also reads SITE_URL, for GoTrue and
# the legacy client — it is a different service on a different port (43171).
# One shared file can't give both their own default at once, so this value
# wins for both. That's fine: nothing needs the legacy client's SITE_URL to
# be correct just to run the one-time importers against db/minio. If you
# specifically want the legacy web client reachable too, override on the
# command line for that invocation: SITE_URL=http://localhost:43171 docker
# compose -f compose.legacy-migration.yaml up -d
SITE_URL=http://localhost:43175
API_BASE_URL=http://localhost:43175
BUKSHELF_API_PUBLIC_URL=http://localhost:43175

# Optional single-owner white-labeling. When the public library is enabled,
# signed-out visitors see only book titles, authors, and proxied cover images.
# Book files, storage keys, and settings stay private.
SELF_HOSTED_BRAND_NAME=Bukshelf
SELF_HOSTED_PUBLIC_LIBRARY=true
# Point this at the source for your deployed modified build when publishing it.
SELF_HOSTED_SOURCE_URL=https://github.com/readest/readest
# Unlock client features whose infrastructure is supplied by this deployment
# (offline TTS downloads and third-party cloud sync). This does not provision
# Readest-hosted services such as the inbound-email Worker.
SELF_HOSTED_PREMIUM_FEATURES=false
# Disable PostHog initialization and remove its opt-in control.
SELF_HOSTED_PRIVACY_MODE=false

# Optional server-managed Reader AI via OpenRouter, proxied by the Bukshelf
# Bun server. The browser never receives this key. Logs include request IDs,
# model, timings and token totals, but not questions or book excerpts. Usage
# is metered persistently in bukshelf.sqlite.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=google/gemini-3.6-flash
OPENROUTER_MAX_INPUT_CHARACTERS=900000
OPENROUTER_MAX_CONCURRENT=2
OPENROUTER_REQUESTS_PER_MINUTE=30
OPENROUTER_TOKENS_PER_DAY=5000000
OPENROUTER_MAX_OUTPUT_TOKENS=2048

# optional Soniox TTS (server-side only), proxied by the Bukshelf Bun server.
# Requests are logged as structured JSON without text content, capped below
# Soniox's default concurrency, and metered persistently in bukshelf.sqlite.
SONIOX_API_KEY=
SONIOX_TTS_MAX_CONCURRENT=2
SONIOX_TTS_MAX_QUEUE_SIZE=32
SONIOX_TTS_REQUESTS_PER_MINUTE=90
SONIOX_TTS_TOKENS_PER_MINUTE_PER_USER=20000
SONIOX_TTS_TOKENS_PER_DAY=500000

# where the reader loads the self-hosted CJK webfont bundles from.
# leave empty to use Readest's CDN (https://storage.readest.com/public/font/dist),
# which only sends CORS headers for readest.com origins - if you serve the app
# from your own domain and want those fonts, mirror the bundles and point this
# at the directory that holds them, e.g. https://your-domain.com/fonts
FONT_BASE_URL=

# Bukshelf data directory. Holds books/, covers/, tmp/, bukshelf.sqlite, and
# backups. Relative paths resolve from apps/bukshelf-server, which is the
# working directory for both `pnpm dev:bukshelf` and `pnpm import:bukshelf`.
# The Docker image ignores this and always uses /data (see compose.yaml).
BUKSHELF_DATA_DIR=../../docker/volumes/bukshelf-data
# Production embeds Next at a fixed image path. `pnpm dev:bukshelf` supplies
# the repository-relative development path automatically.
BUKSHELF_NEXT_DIR=

# ---------------------------------------------------------------------------
# Migration only — docker/compose.legacy-migration.yaml
#
# Everything below configures the pre-Bukshelf Supabase/Postgres/MinIO stack.
# It is NOT part of a fresh Bukshelf install and is not started by
# `docker compose up`. It exists only so someone migrating an existing
# pre-Bukshelf deployment can temporarily bring the old stack back up (with
# its original data volumes) and run the one-time importers
# (`pnpm import:bukshelf`, `auth:import-legacy`) against it, then tear it
# down. See the README's "Migrating from a pre-Bukshelf install" section.
# ---------------------------------------------------------------------------

# ip used by frontend/client-side urls to access the legacy backend
# (used in compose for SUPABASE_PUBLIC_URL)
HOST_IP=localhost
READEST_IMAGE=ghcr.io/readest/readest:latest

# browser-facing urls, derived from HOST_IP unless set here.
# SUPABASE_PUBLIC_URL=https://your-domain.com
# S3_PUBLIC_ENDPOINT=https://your-domain.com

# db(psql) config
# change to strong password, min 32 chars
POSTGRES_PASSWORD=your-super-secret-postgres-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_HOST_PORT=43176

# jwt config
JWT_EXPIRY=3600
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters
# both ANON_KEY and SERVICE_ROLE_KEY should be generated using the above set secret
# sign this payload -> {"role": "anon"} <- for ANON_KEY with JWT_SECRET
ANON_KEY=your-anon-key-jwt-signed-with-jwt-secret
# sign this payload -> {"role": "service_role"} <- for SERVICE_ROLE_KEY with JWT_SECRET
SERVICE_ROLE_KEY=your-service-role-key-jwt-signed-with-jwt-secret

READEST_HTTP_PORT=43171
KONG_HTTP_PORT=43172
MINIO_API_PORT=43173
MINIO_CONSOLE_PORT=43174

# auth (gotrue). SITE_URL for this stack is set above (shared with Bukshelf —
# see the note there).
API_EXTERNAL_URL=http://localhost:43172
ADDITIONAL_REDIRECT_URLS=http://localhost:43171/**,http://localhost:43172/**

# readest auth stuff
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false

# only needed if ENABLE_EMAIL_AUTOCONFIRM is false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_SENDER_NAME=Readest

# PostgREST shiz
PGRST_DB_SCHEMAS=public,graphql_public

# s3 storage through MinIO
OBJECT_STORAGE_TYPE=s3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-secret-password
S3_BUCKET_NAME=readest-files

# 1GB fixed quota for storage and 50k for translations (legacy client only)
STORAGE_FIXED_QUOTA=1073741824
TRANSLATION_FIXED_QUOTA=50000
