{
  "name": "@bukshelf/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "BUKSHELF_NEXT_DIR=../readest-app bun --env-file ../../docker/.env src/server.ts",
    "dev:fresh": "bun --env-file ../../docker/.env src/devFresh.ts && bun run dev",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:docker": "bun e2e/docker-backup.ts",
    "auth:setup": "bun --env-file ../../docker/.env src/cli.ts auth setup",
    "auth:reset": "bun --env-file ../../docker/.env src/cli.ts auth reset",
    "backup": "bun --env-file ../../docker/.env src/backupCli.ts"
  },
  "dependencies": {
    "next": "16.2.11"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
