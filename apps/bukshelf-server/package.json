{
  "name": "@bukshelf/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file ../../docker/.env --watch src/server.ts",
    "start": "bun src/server.ts",
    "import": "bun --env-file ../../docker/.env src/importLegacyCli.ts",
    "test": "bun test",
    "auth:setup": "bun --env-file ../../docker/.env src/cli.ts auth setup",
    "auth:import-legacy": "bun --env-file ../../docker/.env src/cli.ts auth import-legacy",
    "auth:reset": "bun --env-file ../../docker/.env src/cli.ts auth reset",
    "backup": "bun --env-file ../../docker/.env src/backupCli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
